{
  "info": {
    "name": "Mangao WRS – Live API",
    "description": "Live API of the Mangao Water Refilling Station system (Java Spring Boot on Render, MySQL on Aiven). Set the phone and password variables (Collection > Variables) before running the login requests; passwords are not stored in this file.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1 Server and database",
      "item": [
        {
          "name": "Health check (server + database)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Shows that the Java server is running and can reach the MySQL database (database: ok, number of users).",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Price list (public)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/settings/prices",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "settings",
                "prices"
              ]
            },
            "description": "",
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "2 Staff",
      "item": [
        {
          "name": "Log in as staff",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Logs in and saves the token for the next requests.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{staffPhone}}\",\n  \"password\": \"{{staffPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json();",
                  "pm.test('Logged in', () => pm.expect(d.token).to.be.a('string'));",
                  "if (d.token) pm.collectionVariables.set('token', d.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "My account",
          "request": {
            "method": "GET",
