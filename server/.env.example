# Copy this file to .env (START.bat does it the first time). The real .env is never uploaded to GitHub.

# Server
PORT=3100
NODE_ENV=development
# Long random text used to sign log-in tokens. Change it before going online.
JWT_SECRET=change-this-to-a-long-random-text

# MySQL (XAMPP: root with an empty password)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=mangao_wrs

# The one owner account (the setup script puts these in the database)
OWNER_NAME=Ervin P. Mangao
OWNER_PHONE=09170000001
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=owner123

# Email for password reset codes (free Gmail account + App Password).
# Leave SMTP_USER empty while developing: the 6-digit code is printed in the server window instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Mangao Water Refilling Station <no-reply@example.com>

# Push notifications to phones (Firebase Cloud Messaging). Leave empty until the Firebase project
# exists: everything still shows inside the app (bell and banners).
# Firebase console > Project settings > Service accounts > Generate new private key, save the file
# in server\ and put its path here, e.g. FIREBASE_SERVICE_ACCOUNT=firebase-key.json
FIREBASE_SERVICE_ACCOUNT=
