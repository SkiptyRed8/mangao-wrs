{
  "name": "mangao-system-server",
  "version": "1.0.0",
  "private": true,
  "description": "Backend API (Node.js + Express + MySQL) of the Mangao Water Refilling Station Order, Inventory, Sales & Delivery Management System",
  "main": "src/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch-path=src src/server.js",
    "db:setup": "node scripts/setup-db.js",
    "db:demo": "node scripts/setup-db.js --demo",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.1.0"
  },
  "devDependencies": {
    "supertest": "^7.3.1"
  }
}
